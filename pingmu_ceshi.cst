// ============================================================================
// 文件名称: pingmu_ceshi.cst (WM8978 信号全量迁移至 P11 偶数排针版)
// 适用板卡: 芯路恒 ACX750 开发板 + P11 (GPIO0) 40-Pin 音频与MIDI扩展板
// ============================================================================

// ==========================================================
// 1. 系统主时钟输入 (50MHz 有源晶振)
// ==========================================================
IO_LOC "clk_50m" W19;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33;

// ==========================================================
// 2. 9 路全链路诊断指示灯 LED[0]~LED[8] (高电平点亮)
// ==========================================================
IO_LOC "led[0]" U22;
IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_LOC "led[1]" V22;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_LOC "led[2]" W21;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_LOC "led[3]" W22;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_LOC "led[4]" Y21;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_LOC "led[5]" Y22;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;
IO_LOC "led[6]" N13;
IO_PORT "led[6]" IO_TYPE=LVCMOS33;
IO_LOC "led[7]" N17;
IO_PORT "led[7]" IO_TYPE=LVCMOS33;
IO_LOC "led[8]" P17;
IO_PORT "led[8]" IO_TYPE=LVCMOS33;

// ==========================================================
// 3. LCD 屏幕接口 (RGB565, P1 接口)
