`pragma protect end_protected
module fifo_sc_top (
  Data,
  Clk,
  WrEn,
  RdEn,
  Reset,
  Wnum,
  Q,
  Empty,
  Full
)
;
input [23:0] Data;
input Clk;
input WrEn;
input RdEn;
input Reset;
output [4:0] Wnum;
output [23:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo_sc.fifo_sc_top  fifo_sc_inst (
    .Clk(Clk),
    .Reset(Reset),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[23:0]),
    .Full(Full),
    .Empty(Empty),
    .Wnum(Wnum[4:0]),
    .Q(Q[23:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* fifo_sc_top */
